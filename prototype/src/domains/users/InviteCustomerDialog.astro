<dialog class="invite-dialog" id="invite-dialog" aria-labelledby="invite-title"><form id="invite-form" novalidate><header class="dialog-header"><div><p class="eyebrow">People access</p><h2 id="invite-title">Invite customer</h2><p>Create access for this company workspace. An existing platform identity can still be invited.</p></div><button class="icon-button" id="invite-close" type="button" aria-label="Close invite customer">×</button></header><div class="form-feedback" id="form-feedback" aria-live="polite"></div><div class="form-grid"><label>Full name<input id="invite-name" name="name" autocomplete="name" /><span class="field-error" id="name-error"></span></label><label>Email address<input id="invite-email" name="email" type="email" autocomplete="email" /><span class="field-error" id="email-error"></span></label><label>Preferred language<select id="invite-language" name="language"><option>English</option><option>Deutsch</option><option>Español</option></select></label></div><footer class="dialog-footer"><button class="button button-secondary" id="invite-cancel" type="button">Cancel</button><button class="button button-primary" id="invite-submit" type="submit">Send invitation</button></footer></form></dialog>
